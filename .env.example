# Copy to .env and fill in.

# Secret used to sign session cookies (JWT). Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# SQLite database location.
# Dev (running `npm run dev` on the host). SQLite paths are relative to the
# prisma/ folder, so this resolves to prisma/dev.db:
DATABASE_URL=file:./dev.db
# Docker uses file:/data/app.db (set in docker-compose.yml).

# Internal Suwayomi-Server GraphQL engine.
# Dev against the dockerized Suwayomi (port published to localhost):
SUWAYOMI_URL=http://localhost:4567
# Docker uses http://suwayomi:4567 (set in docker-compose.yml).

# Challenge solvers, tried in order and remembered per host. trawl escalates
# HTTP -> cached session -> Camoufox browser -> residential proxy and owns
# POST + sessions along with FlareSolverr; Byparr (stealth Firefox) beats the
# managed challenges FlareSolverr is fingerprinted on but is GET-only. Docker
# sets this automatically.
SOLVERS=trawl@http://localhost:8191,byparr@http://localhost:8192,flaresolverr@http://localhost:8193
# Legacy single-solver form (still honored when SOLVERS is unset):
#FLARESOLVERR_URL=http://localhost:8191
#SOLVER_KIND=flaresolverr

# How long a won clearance cookie is reused before another solve is paid for.
#CLEARANCE_TTL_MS=5400000

# trawl container memory limit (docker-compose.yml).
#TRAWL_MEM=2560m
# trawl's warm browser pool size; the real RAM knob for the Camoufox level.
#TRAWL_POOL_SIZE=2
# How long trawl keeps a cached session in Redis before solving fresh.
#TRAWL_SESSION_TTL=3600
# Redis (trawl's session cache) container memory limit.
#REDIS_MEM=256m

# trawl proxy escalation, both empty (disabled) by default. The VPS's own
# datacenter IP is what gets reputation-banned on some hosts; filling
# RESIDENTIAL_PROXY_URL in is the only real fix for that, not a config knob to
# tune for free.
# Level 3: datacenter proxy.
#PROXY_URL=
#PROXY_LIST_FILE=
# Level 4: residential proxy. The only way out on hosts that answer "IP banned".
#RESIDENTIAL_PROXY_URL=
#RESIDENTIAL_PROXY_LIST_FILE=

# Lets Suwayomi accept the facade's plain response as a fallback when it
# reports the site as "not detected" instead of a challenge. Pre-requisite for
# trusting trawl's/FlareSolverr's answer in every case.
#FLARESOLVERR_RESPONSE_AS_FALLBACK=true

# Secret path segment for /api/solver/<token>/v1, the FlareSolverr-shaped facade
# Suwayomi calls so it gets all three solvers. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SOLVER_PROXY_TOKEN=change-me

# Extension repos for Suwayomi (JSON array of index URLs). Defaults to Keiyoushi,
# which already bundles English and pt-BR sources. Add more repos here, e.g.:
# EXTENSION_REPOS=["https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.min.json","https://<other-repo>/index.min.json"]
#EXTENSION_REPOS=["https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.min.json"]

# ---- Docker deploy (docker compose up -d) ----
# Host port published for the web container; the tunnel routes to it.
# Pick any free port (avoids clashing with other local servers).
WEB_PORT=3000

# Cloudflare Tunnel connector token. Zero Trust dashboard:
# Networks > Tunnels > Create tunnel > copy the token from the install command.
# The tunnel publishes the web app on your own (sub)domain over HTTPS.
CF_TUNNEL_TOKEN=change-me
# COOKIE_SECURE defaults to "true" in docker-compose (HTTPS via Cloudflare) and
# uploads + the SQLite db persist on the ./data volume. No extra vars needed.
